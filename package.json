{
  "name": "codex-model-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "record:timing": "tsx test/record-timing.ts",
    "test:timing": "tsx --test src/turn-timing.test.ts src/cli-proxy.test.ts src/timing-integration.test.ts",
    "test:launcher": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File test/launcher-check.ps1",
    "dev": "tsx src/main.ts",
    "chat": "tsx src/chat.ts",
    "test": "tsx --test src/router.test.ts src/chat.test.ts src/cli-proxy.test.ts src/cli-host.test.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "desktop": "tsx src/desktop.ts",
    "test:desktop": "tsx --test src/desktop.test.ts src/cli-proxy.test.ts",
    "test:cli:core": "tsx --test src/cli-proxy.test.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.162.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/ws": "^8.18.1"
  }
}
